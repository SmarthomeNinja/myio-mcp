{
  "name": "myio-mcp",
  "version": "1.6.0",
  "description": "MCP server for the myIO smart home controller (GIGA/Opta 4.x, Due 3.12)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "watch": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "node test/smoke.mjs",
    "pack": "npm run sync-docs && npm run build && mcpb pack . myio-mcp.mcpb",
    "sync-docs": "node scripts/sync-docs.mjs"
  },
  "keywords": [
    "mcp",
    "myio",
    "smart-home",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
