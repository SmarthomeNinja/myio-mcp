{
  "name": "myio-mcp",
  "version": "1.7.0",
  "mcpName": "io.github.SmarthomeNinja/myio-mcp",
  "description": "MCP server for the myIO smart home controller: Claude and other AI assistants read and control heating, lighting, blinds and energy over the local network",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "myio",
    "smart-home",
    "home-automation",
    "heating",
    "claude"
  ],
  "homepage": "https://myio.hu/en/",
  "bugs": {
    "url": "https://github.com/SmarthomeNinja/myio-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SmarthomeNinja/myio-mcp.git"
  },
  "license": "MIT",
  "author": "myIO Smart Home Zrt.",
  "type": "module",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "myio-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "API_REFERENCE.md",
    "modbus_templates.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "watch": "tsc --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "smoke": "node test/smoke.mjs",
    "pack": "npm run sync-docs && npm run sync-modbus && npm run build && mcpb pack . myio-mcp.mcpb",
    "sync-docs": "node scripts/sync-docs.mjs",
    "sync-modbus": "node scripts/sync-modbus.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
